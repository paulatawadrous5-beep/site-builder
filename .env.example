# --- Storage (Vercel Blob) ---
# Required in production (Vercel). Get it from your Vercel project's
# Storage tab after creating a Blob store, or run `vercel env pull`.
# When unset, the app falls back to a local JSON directory (data/) for
# LOCAL DEVELOPMENT ONLY. Never rely on the local fallback in production.
BLOB_READ_WRITE_TOKEN=

# --- Admin session ---
# A long random secret used to sign the admin session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Admin password ---
# Store ONLY the SHA-256 hash of the admin password, never the password itself.
# Generate it with: node -e "console.log(require('crypto').createHash('sha256').update('YOUR_PASSWORD').digest('hex'))"
ADMIN_PASSWORD_HASH=

# --- Local development only ---
# If ADMIN_PASSWORD_HASH is unset AND NODE_ENV=development, the app accepts
# the password "admin123" and prints a loud warning on every login page load.
# This fallback is DISABLED in production: without ADMIN_PASSWORD_HASH the
# login route refuses all attempts.
